// AERO-F input: quasi-2D embedded cylinder
// Master template. newRun.py copies this into runs/<case>/FluidFile and replaces only
// this header and: BoundaryConditions/Inlet {Mach, Density, Pressure} and
// Time {MaxIts, TimeStep, MaxTime}. Edit everything else by hand here.
// Case M1.5_Re100: Mach = 1.5, Re_D = 100   (written by newRun.py)
//   D = 1 m, T = 288.15 K, a = 340.322 m/s, U = 510.483 m/s
//   mu = 1.78938e-05 Pa s, rho = 3.50527e-06 kg/m^3, p = 0.289983 Pa
//   D/U = 0.00195893 s, dt = 0.02 D/U, tEnd = 300 D/U

under Problem {
    Type      = Unsteady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
    Framework = Embedded;
}

under Input {
    GeometryPrefix  = "../../data/OUTPUT";
    EmbeddedSurface = "../../sources/embeddedSurface.top";
}

// Refinement regions are in mesh coordinates; they must match cylMeshGen.py
// (cylinder center xc, yc = -3.3, 0.1; D = 1; dz = 0.833333; cylinder FaceID = 7).
under AdaptiveMeshRefinement {

    // Shock standoff and wake region: capsule from 1.5 D upstream of the cylinder
    // center, extending 10 D downstream along +x
    under SelectionCriterion[0] {
        Type = APriori;
        PreRefine = On;
        MinimumEdgeLength = 0.1;
        NumLevels = 10;
        under RefinementDomain {
            Type = Capsule;
            under Capsule {
                Point_x = -4.8;
                Point_y = 0.1;
                Point_z = 0.416667;
                Normal_x = 1;
                Normal_y = 0;
                Normal_z = 0;
                Radius = 1.5;
                Length = 11.5;
            }
        }
    }

    // Cells cut by the cylinder surface
    under SelectionCriterion[1] {
        Type = Intersection;
        under PreferredDirection {
            Type = WallDistanceGradient;
        }
        under IntersectionCriterion {
            FaceID = 7;
            Delta = 1e-3;
        }
        PreRefine = On;
        MinimumEdgeLength = 0.02;
        NumLevels = 15;
    }

    Mode = NonDimensional;
    BalancingCriterion = ElemMaxMinRatio;
    BalancingThreshold = 1.05;
    BalancingWeight = 2;
    ImbalanceTolerance = 1.0001;
    MaximumRefinementIterations = 1000;
    MaximumCoarseningIterations = 1000;
    ItrFactor = 10000.0;
    UniformityThreshold = 0.90;
    UniformityThresholdType = MinMax;
    MaximumNumberOfElements = 600000000;
    BisectionStrategy = Isotropic;
    ConsistentNumbering = On;
    RecomputeWallDistance = 2;
}

under Output {
    under Postpro {
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        Temperature = "Temperature";
        LiftandDrag = "LiftandDrag";
        Frequency = 25;
    }
    under Restart {
        Frequency = 25;
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
        EmbeddedPosition = "EmbeddedPosition";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

under Surfaces {
    under SurfaceData[7] {
        ComputeForces = True;
        SeparateForces = False;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5052698818e-06;
        Pressure = 2.8998349357e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
    under Wall {
        Type        = Adiabatic;
        // Wall function or full integration to the wall
        Integration = Full;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Constant;
        //AdvectiveOperator = FiniteVolume; relevant only if linear reconstruction is used
        //Limiter           = Venkatakrishnan; relevant only if linear reconstruction is used
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

under Time {
    Type = Implicit;
    MaxIts = 15010;
    TimeStep = 3.9178590764e-05;
    MaxTime = 5.8767886146e-01;
    under Implicit {
        Type = BackwardEuler;
        MatrixVectorProduct = FiniteDifference;
        under Newton {
            MaxIts = 20;
            Eps = 0.001;
            //FailSafe = AlwaysOn; relevant only if linear reconstruction is used
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}

under EmbeddedFramework {
    Intersector = PhysBAM;
    RiemannNormal = Structure;
    RotatedRiemann = On;
    FillScope = BoundingBox;
}
