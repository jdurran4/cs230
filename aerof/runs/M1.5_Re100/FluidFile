// AERO-F input: quasi-2D embedded cylinder
// Master template for the two run stages of a case (lab FSI_NAS pattern, chained by
// restart):
//   steady    runs/<case>/steady/FluidFile pre-refines the coarse mesh (AMR PreRefine),
//                                          then solves steady from freestream
//   unsteady  runs/<case>/FluidFile        restart from the steady solution and its
//                                          refined mesh; production run
// Lines between "// #if <stages>" and "// #else" / "// #endif" are kept only for the
// listed stages. newRun.py also replaces this header and the `key = value;` lines it
// owns (see newRun.substitutions): Problem/Type, Input paths, AMR capsule Point_z,
// Inlet {Mach, Density, Pressure}, Time {MaxIts, TimeStep, MaxTime}. Edit everything
// else by hand here.
// Case M1.5_Re100, stage unsteady: Mach = 1.5, Re_D = 100   (written by newRun.py)
//   D = 1 m, T = 288.15 K, a = 340.322 m/s, U = 510.483 m/s
//   mu = 1.78848e-05 Pa s, rho = 3.50351e-06 kg/m^3, p = 0.289838 Pa
//   D/U = 0.00195893 s, dt = 0.0255 D/U, tEnd = 100 D/U

under Problem {
    Type      = Unsteady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
    Framework = Embedded;
}

// Paths are written by newRun.py relative to each stage's directory. The steady stage
// reads the coarse mesh; the unsteady stage reads the refined mesh from steady/references/
// (GeometryPrefix) plus MeshData and Solution; no RestartData, so the clock restarts at 0.
under Input {
    GeometryPrefix  = "steady/references/OUTPUT";
    EmbeddedSurface = "../../sources/embeddedSurface.top";
    MeshData        = "steady/references/MeshData";
    Solution        = "steady/references/Solution";
}

// Refinement regions are in mesh coordinates; they must match cylMeshGen.py
// (cylinder center xc, yc = -3.3, 0.1; D = 1; cylinder FaceID = 7). Every Point_z is
// written by newRun.py as the mid-plane dz/2 of the fluid layer.
//
// Steady stage: criteria [0] and [1] pre-refine at t = 0 (geometry only); the Hessian
// criterion [2] then adapts to the flow every Frequency iterations of the steady solve.
// Unsteady stage: Frequency = 0, so the steady stage's mesh is kept frozen (pre-refine
// at t = 0 finds nothing left to refine): every snapshot is on one mesh.
under AdaptiveMeshRefinement {

    // Baseline bow shock and wake region: capsule of radius 2 D whose axis runs along +x
    // from 1.5 D upstream of the cylinder center to 10 D downstream (rounded ends reach
    // ~3.5 D upstream; bow shock standoff at M1.5 is ~1.5 D ahead of the surface).
    // Keeps the wake resolved even if a case sheds after the steady stage.
    under SelectionCriterion[0] {
        Type = APriori;
        PreRefine = On;
        MinimumEdgeLength = 0.1;
        NumLevels = 10;
        under RefinementDomain {
            Type = Capsule;
            under Capsule {
                Point_x = -4.8;
                Point_y = 0.1;
                Point_z = 0.05;
                Normal_x = 1;
                Normal_y = 0;
                Normal_z = 0;
                Radius = 2.0;
                Length = 11.5;
            }
        }
    }

    // Cells cut by the cylinder surface
    under SelectionCriterion[1] {
        Type = Intersection;
        under PreferredDirection {
            Type = WallDistanceGradient;
        }
        under IntersectionCriterion {
            FaceID = 7;
            Delta = 1e-3;
        }
        PreRefine = On;
        MinimumEdgeLength = 0.02;
        NumLevels = 15;
    }

    // Flow-adaptive: Hessian of the velocity (lab FSI_NAS CapsuleSteady settings), to
    // sharpen the bow shock and shear layers below the baseline. Capsule of radius 4 D
    // from 3 D upstream of the cylinder center to 12 D downstream, which contains the
    // M1.5 bow shock (asymptotically the 42 deg Mach angle) out to |y - yc| = 4 D.
    // Thresholds are a starting point: tune on the first runs.
    under SelectionCriterion[2] {
        Type = Hessian;
        under HessianCriterion {
            SensorType = Velocity;
            Threshold = 1.0e-2;
            HessianConstruction = LeastSquares;
            CoarseningThreshold = 2.0e-3;
        }
        under RefinementDomain {
            Type = Capsule;
            under Capsule {
                Point_x = -6.3;
                Point_y = 0.1;
                Point_z = 0.05;
                Normal_x = 1;
                Normal_y = 0;
                Normal_z = 0;
                Radius = 4.0;
                Length = 15.0;
            }
        }
        PreRefine = Off;     // needs a flow field
        MinimumEdgeLength = 0.025;
        NumLevels = 5;
    }

    InitializeRefinementTag = On;
    Frequency = 0;             // frozen mesh
    Mode = NonDimensional;
    BalancingCriterion = ElemMaxMinRatio;
    BalancingThreshold = 1.05;
    BalancingWeight = 2;
    ImbalanceTolerance = 1.05;
    MaximumRefinementIterations = 1000;
    MaximumCoarseningIterations = 1000;
    ItrFactor = 1000.0;
    UniformityThreshold = 0.05;
    UniformityThresholdType = MinMax;
    MaximumNumberOfElements = 1000000;
    // Refine3D = 0 refines only edges lying in the x-y plane, for quasi-2D one-layer
    // meshes. With Arbitrary bisection the manual warns the mesh quality "tends to be
    // poor, particularly if the initial mesh is coarse": refined faces stay attached to
    // coarse vertices across the layer (~0.75 m x-y skew, ~10% bottom/top pressure
    // mismatch in M1.5_Re100). Refine3D = 1 (default) also splits edges across the layer.
    Refine3D = 1;
    // Arbitrary = longest-edge bisection: with the thin layer (dz = 0.1 << h) the in-plane
    // edges are split first and the layer only once in-plane edges reach ~dz (~5 layers
    // at the 0.02 m cylinder spacing). Isotropic splits every edge at every level, so it
    // keeps each coarse tet's h/dz aspect ratio and needs h/h_min ~ 33 layers near the
    // cylinder whatever dz is (hit the 1M element cap); it suits cube-like starting tets.
    BisectionStrategy = Arbitrary;
    ConsistentNumbering = On;
    RecomputeWallDistance = 0;
}

under Output {
    under Postpro {
        PostprocessSides = 1;
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        Temperature = "Temperature";
        LiftandDrag = "../postpro/LiftandDrag";
        EmbeddedSurfaceForce = "../postpro/EmbeddedSurfaceForce";
        Frequency = 25;
    }
    under Restart {
        Frequency = 100;
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
        EmbeddedPosition = "EmbeddedPosition";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

under Surfaces {
    under SurfaceData[7] {
        ComputeForces = True;
        SeparateForces = False;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5035117527e-06;
        Pressure = 2.8983804730e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
    under Wall {
        Type        = Adiabatic;
        // Wall function or full integration to the wall
        Integration = Full;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Linear;
        AdvectiveOperator = FiniteVolume;
        Limiter           = Venkatakrishnan;
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

under Time {
    Type = Implicit;
    MaxIts = 3932;
    TimeStep = 4.9952703224e-05;
    MaxTime = 1.9589295382e-01;
    under Implicit {
        Type = RungeKutta2;   // 2-stage, 2nd-order DIRK
        MatrixVectorProduct = FiniteDifference;
        under Newton {
            MaxIts = 20;
            Eps = 0.001;
            FailSafe = AlwaysOn;   // fall back to first order where Newton fails (linear reconstruction)
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}

under EmbeddedFramework {
    Intersector = PhysBAM;
    RiemannNormal = Structure;
    RotatedRiemann = On;
    FillScope = BoundingBox;
}
