// AERO-F input: quasi-2D embedded cylinder, generated by writeFluidFile.py
// Case M1.5_Re100: Mach = 1.5, Re_D = 100
//   D = 1 m, T = 288.15 K, a = 340.322 m/s, U = 510.483 m/s
//   mu = 1.78938e-05 Pa s, rho = 3.50527e-06 kg/m^3, p = 0.289983 Pa
//   D/U = 0.00195893 s, dt = 0.02 D/U, tEnd = 300 D/U, output every 25 steps

under Problem {
    Type      = Unsteady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
    Framework = Embedded;
}

under Input {
    GeometryPrefix  = "../../data/OUTPUT";
    EmbeddedSurface = "../../sources/embeddedSurface.top";
}

under Output {
    under Postpro {
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        LiftandDrag = "LiftandDrag";
        Frequency = 25;
    }
    under Restart {
        Frequency = 25;
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
        EmbeddedPosition = "EmbeddedPosition";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

under Surfaces {
    under SurfaceData[7] {
        ComputeForces = True;
        SeparateForces = False;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5052698818e-06;
        Pressure = 2.8998349357e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
    under Wall {
        Type        = Adiabatic;
        // Wall function or full integration to the wall
        Integration = Full;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Constant;
        //AdvectiveOperator = FiniteVolume; relevant only if linear reconstruction is used
        //Limiter           = Venkatakrishnan; relevant only if linear reconstruction is used
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

under Time {
    Type = Implicit;
    MaxIts = 100;
    TimeStep = 2e-05;
    MaxTime = 0.5;
    under Implicit {
        Type = BackwardEuler;
        MatrixVectorProduct = FiniteDifference;
        under Newton {
            MaxIts = 20;
            Eps = 0.001;
            //FailSafe = AlwaysOn; relevant only if linear reconstruction is used
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}

under EmbeddedFramework {
    Intersector = PhysBAM;
    RiemannNormal = Structure;
    RotatedRiemann = On;
    FillScope = BoundingBox;
}
