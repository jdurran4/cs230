// AERO-F input: quasi-2D embedded cylinder
// Master template for the three run stages (lab FSI_NAS pattern, chained by restart):
//   mesh      runs/mesh/FluidFile          PreRefine only (Steady, MaxIts = 0): builds the
//                                          refined mesh once; shared by every (M, Re) case
//   steady    runs/<case>/steady/FluidFile steady solve from freestream on that mesh
//   unsteady  runs/<case>/FluidFile        restart from the steady solution; production
// Lines between "// #if <stages>" and "// #else" / "// #endif" are kept only for the
// listed stages. newRun.py also replaces this header and the `key = value;` lines it
// owns (see newRun.substitutions): Problem/Type, Input paths, Inlet {Mach, Density,
// Pressure}, Time {MaxIts, TimeStep, MaxTime}. Edit everything else by hand here.
// Case M1.5_Re100, stage steady: Mach = 1.5, Re_D = 100   (written by newRun.py)
//   D = 1 m, T = 288.15 K, a = 340.322 m/s, U = 510.483 m/s
//   mu = 1.78848e-05 Pa s, rho = 3.50351e-06 kg/m^3, p = 0.289838 Pa
//   D/U = 0.00195893 s, steady, MaxIts = 1000

under Problem {
    Type      = Steady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
    Framework = Embedded;
}

// Paths are written by newRun.py relative to each stage's directory. A restarted stage
// reads the refined mesh from the previous stage's references/ (GeometryPrefix) plus
// MeshData; no RestartData, so the clock restarts at t = 0.
under Input {
    GeometryPrefix  = "../../mesh/references/OUTPUT";
    EmbeddedSurface = "../../../sources/embeddedSurface.top";
    MeshData        = "../../mesh/references/MeshData";
}

// Refinement regions are in mesh coordinates; they must match cylMeshGen.py
// (cylinder center xc, yc = -3.3, 0.1; D = 1; dz = 0.833333; cylinder FaceID = 7).
under AdaptiveMeshRefinement {

    // Bow shock and wake region: capsule of radius 2 D whose axis runs along +x from
    // 1.5 D upstream of the cylinder center to 10 D downstream (rounded ends reach
    // ~3.5 D upstream; bow shock standoff at M1.5 is ~1.5 D ahead of the surface)
    under SelectionCriterion[0] {
        Type = APriori;
        PreRefine = On;
        MinimumEdgeLength = 0.1;
        NumLevels = 10;
        under RefinementDomain {
            Type = Capsule;
            under Capsule {
                Point_x = -4.8;
                Point_y = 0.1;
                Point_z = 0.416667;
                Normal_x = 1;
                Normal_y = 0;
                Normal_z = 0;
                Radius = 2.0;
                Length = 11.5;
            }
        }
    }

    // Cells cut by the cylinder surface
    under SelectionCriterion[1] {
        Type = Intersection;
        under PreferredDirection {
            Type = WallDistanceGradient;
        }
        under IntersectionCriterion {
            FaceID = 7;
            Delta = 1e-3;
        }
        PreRefine = On;
        MinimumEdgeLength = 0.02;
        NumLevels = 15;
    }

    InitializeRefinementTag = On;
    Frequency = 10000;
    Mode = NonDimensional;
    BalancingCriterion = ElemMaxMinRatio;
    BalancingThreshold = 1.05;
    BalancingWeight = 2;
    ImbalanceTolerance = 1.05;
    MaximumRefinementIterations = 1000;
    MaximumCoarseningIterations = 1000;
    ItrFactor = 1000.0;
    UniformityThreshold = 0.05;
    UniformityThresholdType = MinMax;
    MaximumNumberOfElements = 1000000;
    // Refine3D = 0 refines only edges lying in the x-y plane, for quasi-2D one-layer
    // meshes. With Arbitrary bisection the manual warns the mesh quality "tends to be
    // poor, particularly if the initial mesh is coarse": refined faces stay attached to
    // coarse vertices across the layer (~0.75 m x-y skew, ~10% bottom/top pressure
    // mismatch in M1.5_Re100). Refine3D = 1 (default) also splits edges across the layer.
    Refine3D = 1;
    BisectionStrategy = Arbitrary;
    ConsistentNumbering = On;
    RecomputeWallDistance = 0;
}

under Output {
    under Postpro {
        PostprocessSides = 1;
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        Temperature = "Temperature";
        LiftandDrag = "../postpro/LiftandDrag";
        EmbeddedSurfaceForce = "../postpro/EmbeddedSurfaceForce";
        Frequency = 0;     // fields only at the last iteration (LiftandDrag every iteration)
    }
    under Restart {
        Frequency = 100;
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
        EmbeddedPosition = "EmbeddedPosition";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

under Surfaces {
    under SurfaceData[7] {
        ComputeForces = True;
        SeparateForces = False;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5035117527e-06;
        Pressure = 2.8983804730e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
    under Wall {
        Type        = Adiabatic;
        // Wall function or full integration to the wall
        Integration = Full;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Linear;
        AdvectiveOperator = FiniteVolume;
        Limiter           = Venkatakrishnan;
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

// Steady: local time stepping with a CFL ramp (lab CapsuleSteady settings). The mesh
// stage uses MaxIts = 0: it only pre-refines and writes the restart files.
under Time {
    Type = Implicit;
    MaxIts = 1000;
    Eps = 1e-8;
    under CflLaw {
        Strategy = Hybrid;
        Cfl0 = 1;
        CflMax = 100;
    }
    under Implicit {
        Type = BackwardEuler;
        MatrixVectorProduct = FiniteDifference;
        under Newton {
            MaxIts = 1;
            Eps = 0.001;
            FailSafe = On;
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}

under EmbeddedFramework {
    Intersector = PhysBAM;
    RiemannNormal = Structure;
    RotatedRiemann = On;
    FillScope = BoundingBox;
}
