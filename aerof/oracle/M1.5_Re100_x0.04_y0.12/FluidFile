// AERO-F input: ORACLE coarse run for case M1.5_Re100_x0.04_y0.12 (Mach 1.5, Re_D 100).
// The coarse mesh (h = 0.833, D/h = 1.2) with NO cylinder and NO AMR. The cylinder is
// replaced by the exact source binned from the resolved run (runs/M1.5_Re100_x0.04_y0.12)
// onto the coarse columns: oracleSource.txt, written by ../../oracleSource.py.
// Question: does the coarse flow with the exact source match the resolved flow binned
// onto the coarse grid?
// Settings are copied from runs/M1.5_Re100_x0.04_y0.12/FluidFile; removed: Framework =
// Embedded, Input/EmbeddedSurface, AdaptiveMeshRefinement, EmbeddedFramework, Surfaces,
// and the LiftandDrag / EmbeddedSurfaceForce outputs (no surface).
//   D = 1 m, T = 288.15 K, a = 340.322 m/s, U = 510.483 m/s
//   mu = 1.78848e-05 Pa s, rho = 3.50351e-06 kg/m^3, p = 0.289838 Pa

under Problem {
    Type      = Steady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
}

under Input {
    GeometryPrefix  = "../../data/OUTPUT";
}

under Output {
    under Postpro {
        PostprocessSides = 1;
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        Temperature = "Temperature";
        Frequency = 0;     // fields only at the last iteration
    }
    under Restart {
        Frequency = 100;
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    // Uncomment once the keyword exists in AERO-F (source-terms branch):
    OracleSourceFile = "oracleSource.txt";
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5035117527e-06;
        Pressure = 2.8983804730e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Linear;
        AdvectiveOperator = FiniteVolume;
        Limiter           = Venkatakrishnan;
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

// Steady: local time stepping with a CFL ramp (lab CapsuleSteady settings).
under Time {
    Type = Implicit;
    MaxIts = 1000;
    Eps = 1e-5;
    under CflLaw {
        Strategy = Hybrid;
        Cfl0 = 1;
        CflMax = 100;
    }
    under Implicit {
        Type = BackwardEuler;
        MatrixVectorProduct = FiniteDifference;
        under Newton {
            MaxIts = 1;
            Eps = 0.001;
            FailSafe = On;
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}
