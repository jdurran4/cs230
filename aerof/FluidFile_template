// AERO-F input: quasi-2D embedded cylinder
// Master template. newRun.py copies this into runs/<case>/FluidFile and replaces only
// this header and: BoundaryConditions/Inlet {Mach, Density, Pressure} and
// Time {MaxIts, TimeStep, MaxTime}. Edit everything else by hand here.
// CASE-INFO

under Problem {
    Type      = Unsteady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
    Framework = Embedded;
}

under Input {
    GeometryPrefix  = "../../data/OUTPUT";
    EmbeddedSurface = "../../sources/embeddedSurface.top";
}

// Refinement regions are in mesh coordinates; they must match cylMeshGen.py
// (cylinder center xc, yc = -3.3, 0.1; D = 1; dz = 0.833333; cylinder FaceID = 7).
under AdaptiveMeshRefinement {

    // Bow shock and wake region: capsule of radius 2 D whose axis runs along +x from
    // 1.5 D upstream of the cylinder center to 10 D downstream (rounded ends reach
    // ~3.5 D upstream; bow shock standoff at M1.5 is ~1.5 D ahead of the surface)
    under SelectionCriterion[0] {
        Type = APriori;
        PreRefine = On;
        MinimumEdgeLength = 0.1;
        NumLevels = 10;
        under RefinementDomain {
            Type = Capsule;
            under Capsule {
                Point_x = -4.8;
                Point_y = 0.1;
                Point_z = 0.416667;
                Normal_x = 1;
                Normal_y = 0;
                Normal_z = 0;
                Radius = 2.0;
                Length = 11.5;
            }
        }
    }

    // Cells cut by the cylinder surface
    under SelectionCriterion[1] {
        Type = Intersection;
        under PreferredDirection {
            Type = WallDistanceGradient;
        }
        under IntersectionCriterion {
            FaceID = 7;
            Delta = 1e-3;
        }
        PreRefine = On;
        MinimumEdgeLength = 0.02;
        NumLevels = 15;
    }

    InitializeRefinementTag = On;
    Frequency = 10000;
    Mode = NonDimensional;
    BalancingCriterion = ElemMaxMinRatio;
    BalancingThreshold = 1.05;
    BalancingWeight = 2;
    ImbalanceTolerance = 1.05;
    MaximumRefinementIterations = 1000;
    MaximumCoarseningIterations = 1000;
    ItrFactor = 1000.0;
    UniformityThreshold = 0.05;
    UniformityThresholdType = MinMax;
    MaximumNumberOfElements = 1000000;
    // Quasi-2D: Refine3D = 0 (undocumented, from lab) refines only in the plane normal
    // to z (the default normal), so edges spanning the one-cell z thickness are not split
    Refine3D = 0;
    BisectionStrategy = Arbitrary;
    ConsistentNumbering = On;
    RecomputeWallDistance = 0;
}

under Output {
    under Postpro {
        PostprocessSides = 1;
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        Temperature = "Temperature";
        LiftandDrag = "LiftandDrag";
        Frequency = 25;
    }
    under Restart {
        Frequency = 100;
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
        EmbeddedPosition = "EmbeddedPosition";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

under Surfaces {
    under SurfaceData[7] {
        ComputeForces = True;
        SeparateForces = False;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5052698818e-06;
        Pressure = 2.8998349357e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
    under Wall {
        Type        = Adiabatic;
        // Wall function or full integration to the wall
        Integration = Full;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Linear;
        AdvectiveOperator = FiniteVolume;
        Limiter           = Venkatakrishnan;
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

under Time {
    Type = Implicit;
    MaxIts = 100;
    TimeStep = 2e-05;
    MaxTime = 0.5;
    under Implicit {
        Type = RungeKutta2;   // 2-stage, 2nd-order DIRK
        MatrixVectorProduct = FiniteDifference;
        under Newton {
            MaxIts = 20;
            Eps = 0.001;
            FailSafe = AlwaysOn;   // fall back to first order where Newton fails (linear reconstruction)
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}

under EmbeddedFramework {
    Intersector = PhysBAM;
    RiemannNormal = Structure;
    RotatedRiemann = On;
    FillScope = BoundingBox;
}
