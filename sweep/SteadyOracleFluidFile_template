// AERO-F input: STEADY coarse ORACLE run (unsteady/oracle/steady/<case>/FluidFile)
// The unsteady oracle setup (OracleFluidFile_template: coarse extruded mesh, no cylinder,
// no AMR) driven by the constant true source of a converged steady resolved run
// (steady-v0/runs/<case>, last output), solved to steady state with the pseudo-time
// settings of the steady-v0 coarse oracles. oracleSource.txt holds the source twice
// (t = 0 and 1 s; AERO-F needs >= 2 snapshots and interpolates between them).
// oracle.py replaces this header and the `key = value;` lines it owns (see
// oracle.steadySetupCase): Input/GeometryPrefix, Inlet {Mach, Density, Pressure}.
// CASE-INFO

under Problem {
    Type      = Steady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
}

under Input {
    GeometryPrefix  = "../../data/OUTPUT";
}

under Output {
    under Postpro {
        PostprocessSides = 1;
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        Temperature = "Temperature";
        Frequency = 0;     // fields only at the last iteration
    }
    under Restart {
        Frequency = 100;
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    // Time series of the binned source per coarse node (format in sweep/oracle.py)
    OracleSourceFile = "oracleSource.txt";
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5052698818e-06;
        Pressure = 2.8998349357e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Linear;
        AdvectiveOperator = FiniteVolume;
        Limiter           = Venkatakrishnan;
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

// Pseudo-time to steady state, as the steady-v0 coarse oracles
under Time {
    Type = Implicit;
    MaxIts = 1000;
    Eps = 1e-5;
    under CflLaw {
        Strategy = Hybrid;
        Cfl0 = 1;
        CflMax = 100;
    }
    under Implicit {
        Type = BackwardEuler;
        MatrixVectorProduct = FiniteDifference;
        under Newton {
            MaxIts = 1;
            Eps = 0.001;
            FailSafe = On;
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}
