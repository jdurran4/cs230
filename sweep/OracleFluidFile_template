// AERO-F input: unsteady coarse ORACLE run (unsteady/oracle/runs/<case>/FluidFile)
// The coarse mesh (h = D/1.2, the sweep's x-y grid extruded to several z-layers) with NO
// cylinder and NO AMR. The cylinder is replaced by the true source S(t) binned from the
// resolved run unsteady/runs/<case> onto the coarse 3D dual cells (oracleSource.txt,
// written by sweep/oracle.py). Impulsive start from freestream, same time step, end time
// and solver settings as the resolved run (FluidFile_template), so the run is what the
// online neural source will see, with the exact source.
// Removed from FluidFile_template: Framework = Embedded, Input/EmbeddedSurface,
// AdaptiveMeshRefinement, EmbeddedFramework, Surfaces, Wall, and the LiftandDrag /
// EmbeddedSurfaceForce outputs (no surface).
// oracle.py replaces this header and the `key = value;` lines it owns (see
// oracle.substitutions): Input/GeometryPrefix, Inlet {Mach, Density, Pressure},
// Time {MaxIts, TimeStep, MaxTime}, Postpro and Restart Frequency.
// CASE-INFO

under Problem {
    Type      = Unsteady;
    Mode      = Dimensional;
    Prec      = NonPreconditioned;
}

under Input {
    GeometryPrefix  = "../../data/OUTPUT";
}

under Output {
    under Postpro {
        PostprocessSides = 1;
        Prefix = "./results/";
        Mach = "Mach";
        Pressure = "Pressure";
        Density = "Density";
        Velocity = "Velocity";
        Temperature = "Temperature";
        Frequency = 5;     // snapshot every Frequency steps (oracle: outputEvery D/U)
    }
    under Restart {
        Frequency = 200;   // oracle: restartEvery D/U
        Prefix = "./references/";
        Solution = "Solution";
        RestartData = "RestartData";
        MeshData = "MeshData";
    }
}

// Laminar Navier-Stokes (no TurbulenceClosure)
under Equations {
    Type = NavierStokes;
    // Time series of the binned source per coarse node (format in sweep/oracle.py)
    OracleSourceFile = "oracleSource.txt";
    under FluidModel[0] {
        Fluid = PerfectGas;
        under GasModel {
            SpecificHeatRatio = 1.4;
        }
    }
    under ViscosityModel {
        Type = Sutherland;
    }
}

// Flow in +x
under BoundaryConditions {
    under Inlet {
        Type     = External;
        Mach     = 1.5;
        Density  = 3.5052698818e-06;
        Pressure = 2.8998349357e-01;
        Alpha    = 0.0;
        Beta     = 0.0;
    }
}

under Space {
    under NavierStokes {
        Flux              = HLLC;
        Reconstruction    = Linear;
        AdvectiveOperator = FiniteVolume;
        Limiter           = Venkatakrishnan;
        Gradient          = LeastSquares;
        Dissipation       = SecondOrder;
        Beta              = 0.5;
        Gamma             = 1.0;
    }
    under Boundaries {
        Type = StegerWarming;
    }
}

// Same as the resolved runs (FluidFile_template)
under Time {
    Type = Implicit;
    MaxIts = 1100;
    TimeStep = 9.79e-05;
    MaxTime = 0.0979;
    under Implicit {
        Type = RungeKutta2;   // 2-stage, 2nd-order DIRK
        MatrixVectorProduct = FiniteDifference;   // includes any source term in R(U)
        under Newton {
            MaxIts = 20;
            Eps = 0.001;
            FailSafe = AlwaysOn;
            Output = "newton.log";
            under LinearSolver {
                under NavierStokes {
                    Type = Gmres;
                    MaxIts = 100;
                    KrylovVectors = 100;
                    Eps = 0.01;
                    under Preconditioner {
                        Type = Ras;
                        Fill = 0;
                    }
                }
            }
        }
    }
}
